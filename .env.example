# Copy this file to .env.local for local development.
# Never commit real values. Never prefix the service role key with NEXT_PUBLIC_.

# Public (safe for the browser) - Supabase project URL and anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only - used only in trusted server code (e.g. admin scripts). Never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for auth redirects and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
